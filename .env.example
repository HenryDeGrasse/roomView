OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
ROOMVIEW_PLANNER_MODE=openrouter
ROOMVIEW_PHOTOREAL_PROVIDER=deterministic_stub
# Example Gemini image model via OpenRouter:
# ROOMVIEW_PHOTOREAL_PROVIDER=openrouter
# ROOMVIEW_PHOTOREAL_MODEL=google/gemini-3-pro-image-preview
# ROOMVIEW_PHOTOREAL_IMAGE_SIZE=1K
# ROOMVIEW_PHOTOREAL_TIMEOUT_MS=90000
# Showcase-phase Flux inpaint stack (Track A):
# ROOMVIEW_PHOTOREAL_PROVIDER=flux_inpaint_stack
# ROOMVIEW_FLUX_BACKEND_URL=https://your-modal-endpoint.modal.run
# ROOMVIEW_FLUX_BACKEND_TOKEN=your-backend-token
# ROOMVIEW_MASK_SERVICE_MODE=fixture   # fixture | sam2_local | sam2_modal
# ROOMVIEW_MASK_SERVICE_URL=https://your-mask-service.modal.run
# ROOMVIEW_ICLIGHT_ENABLED=true
# Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ROOMVIEW_SITE_URL=http://127.0.0.1:3000
# ROOMVIEW_APP_NAME=RoomView MVP Local
# ROOMVIEW_PLANNER_TIMEOUT_MS=25000
